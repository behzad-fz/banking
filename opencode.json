{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode-go/gpt-5.6-luna",
  "small_model": "opencode-go/glm-5.3-flash",
  "agent": {
    "build": {
      "model": "opencode-go/gpt-5.6-luna"
    },
    "explore": {
      "model": "opencode-go/glm-5.3-flash"
    },
    "general": {
      "model": "opencode-go/glm-5.3-flash"
    },
    "plan": {
      "model": "opencode-go/glm-5.3-flash"
    },
    "reviewer": {
      "model": "opencode-go/gpt-5.6-luna"
    }
  },
  "mcp": {
    "atlassian": {
      "type": "remote",
      "url": "https://mcp.atlassian.com/v1/mcp/authv2",
      "enabled": true,
      "oauth": {}
    }
  },
  "references": {
    "roadmap": {
      "path": "docs/roadmap.md",
      "description": "Use for the human-owned product roadmap; near-term items become backlog tickets"
    },
    "plans": {
      "path": "docs/plans",
      "description": "Use for past and current backlog batch plans"
    },
    "specs": {
      "path": "docs/superpowers/specs",
      "description": "Use for approved design specs (e.g. the backlog planner design)"
    }
  },
  "permission": {
    "read": {
      "*": "allow",
      "**/application-secrets.properties": "deny",
      "**/*.pem": "deny",
      "**/certs/**": "deny",
      "**/.env*": "deny",
      "**/secrets/**": "deny"
    },
    "edit": {
      "*": "allow",
      "**/application-secrets.properties": "deny",
      "**/*.pem": "deny",
      "**/certs/**": "deny",
      "**/.env*": "deny",
      "**/secrets/**": "deny"
    },
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "task": "allow",
    "todowrite": "allow",
    "webfetch": "allow",
    "skill": "allow",
    "external_directory": {
      "*": "allow",
      "**/secrets/**": "deny",
      "**/.ssh/**": "deny"
    },
    "bash": {
      "*": "allow",
      "git -c * push*": "deny",
      "git push* --force*": "deny",
      "git push* -f*": "deny",
      "git rebase*": "deny",
      "git pull* --rebase*": "deny",
      "git reset* --hard*": "deny",
      "git merge *": "deny",
      "gh pr merge*": "deny",
      "rm -rf*": "deny",
      "rm -r -f*": "deny",
      "rm -fr*": "deny",
      "docker compose down -v*": "deny",
      "docker compose exec mysql mysql -e *drop*": "deny",
      "docker compose exec mysql mysql -e *DROP*": "deny",
      "mysql -e *drop*": "deny",
      "mysql -e *DROP*": "deny"
    }
  }
}
